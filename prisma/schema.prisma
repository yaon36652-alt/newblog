// Prisma schema —— 数据库表结构定义（见 doc/tech.md 第 5 节）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // 本地开发与 CLI 校验使用 file:；云端（Turso）连接由代码里的 driver adapter 接管
  // 注意：CLI 校验要求 url 必须以 file: 开头，云端地址通过 TURSO_DATABASE_URL 传给 adapter
  url = "file:./dev.db"
}

// 管理员账号
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// 文章
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  summary   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 关于我（单行数据）
model About {
  id      Int    @id @default(autoincrement())
  avatar  String @default("")
  intro   String @default("")
  contact String @default("")
}
